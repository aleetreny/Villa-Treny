  "publicMessages": [
    {
      "id": "turn:3",
      "conversationId": "conversation:2",
      "participants": [
        "A",
        "U"
      ],
      "speaker": "A",
      "text": "Ulla, may I borrow some paper and ink from the records room for a writing project?",
      "atMs": 1788873160826
    },
    {
      "id": "turn:8",
      "conversationId": "conversation:7",
      "participants": [
        "B",
        "K"
      ],
      "speaker": "B",
      "text": "No problem at all, could you let me know what the current communication backlog looks like?",
      "atMs": 1788873339160
    },
    {
      "id": "turn:12",
      "conversationId": "conversation:2",
      "participants": [
        "A",
        "U"
      ],
      "speaker": "U",
      "text": "Sure, I can spare some paper and ink – just let me know how much you need and when you’ll return it.",
      "atMs": 1788873515967
    },
    {
      "id": "turn:18",
      "conversationId": "conversation:17",
      "participants": [
        "C",
        "N"
      ],
      "speaker": "C",
      "text": "Noor, I need the waking criteria documented before any case arises. Please sit and write them down.",
      "atMs": 1788873699272
    },
    {
      "id": "turn:22",
      "conversationId": "conversation:7",
      "participants": [
        "B",
        "K"
      ],
      "speaker": "K",
      "text": "The backlog is light right now—just a few pending logs from the workshops and a couple of status updates from the garden. Anything specific you need?",
      "atMs": 1788873877826
    },
    {
      "id": "turn:27",
      "conversationId": "conversation:26",
      "participants": [
        "D",
        "H"
      ],
      "speaker": "D",
      "text": "Halim, could we schedule a brief review of the dock's structural integrity to ensure nothing unexpected arises?",
      "atMs": 1788874057822
    },
    {
      "id": "turn:33",
      "conversationId": "conversation:2",
      "participants": [
        "A",
        "U"
      ],
      "speaker": "A",
      "text": "Thank you, Ulla. Could I take enough paper for a few pages and a vial of ink, and return them by tomorrow?",
      "atMs": 1788874237138
    },
    {
      "id": "turn:38",
      "conversationId": "conversation:37",
      "participants": [
        "E",
        "L"
      ],
      "speaker": "E",
      "text": "Lior, the salvage allocation of 4 materials to the workshops seems excessive when we have only 21 in stock; could we reassign 2 to the garden instead?",
      "atMs": 1788874419830
    },
    {
      "id": "turn:43",
      "conversationId": "conversation:17",
      "participants": [
        "C",
        "N"
      ],
      "speaker": "N",
      "text": "Cato, how did you sleep last night? Once you're rested, I can sit down and draft the waking criteria for you.",
      "atMs": 1788874600567
    },
    {
      "id": "turn:48",
      "conversationId": "conversation:47",
      "participants": [
        "F",
        "M"
      ],
      "speaker": "F",
      "text": "Hey Mara, I heard the Common's coffee is so strong it could dig a tunnel—any chance you need a hand (or a joke) with the next excavation?",
      "atMs": 1788874778148
    },
    {
      "id": "turn:54",
      "conversationId": "conversation:7",
      "participants": [
        "B",
        "K"
      ],
      "speaker": "B",
      "text": "Could you forward the latest garden status updates and any pending workshop logs?",
      "atMs": 1788874956841
    }
