          "nextSpeaker": "N",
          "expiresAtMs": 1788912003001,
          "turns": [
            {
              "id": "turn:14",
              "speaker": "C",
              "text": "Noor. I need the criteria for waking a patient documented. We cannot rely on verbal consensus during an emergency.",
              "atMs": 1788825603001
            }
          ]
        },
        {
          "id": "conversation:19",
          "participants": [
