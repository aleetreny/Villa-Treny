{
  "name": "villa-treny",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-distribution.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "pnpm lint && pnpm typecheck && node --test scripts/legacy-room-art.test.mjs && pnpm test && pnpm runtime:check",
    "check:all": "pnpm check && pnpm build && pnpm test:browser",
    "rooms:export": "node scripts/export-rooms.mjs",
    "rooms:capture-legacy": "node scripts/capture-legacy-room-art.mjs",
    "society:audit": "node tools/habitat/society-audit.mjs",
    "runtime:dev": "pnpm --dir workers/habitat-runtime dev",
    "runtime:check": "pnpm --dir workers/habitat-runtime check",
    "runtime:deploy:dry": "pnpm --dir workers/habitat-runtime deploy:dry",
    "runtime:deploy": "pnpm --dir workers/habitat-runtime deploy",
    "society:validate": "node tools/habitat/validate-society.mjs",
    "cognition:audit": "node tools/habitat/measure-prompts.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "@playwright/test": "1.62.1"
  }
}
